#: contents/config/config.qml
msgid "Appearance"
msgstr "Apparence"

#: contents/ui/configAppearance.qml
msgid "General"
msgstr "Général"

#: contents/ui/configAppearance.qml
msgid "Element spacing:"
msgstr "Espacement des éléments :"

#: contents/ui/configAppearance.qml
msgid "Locale:"
msgstr "Paramètres régionaux :"

#: contents/ui/configAppearance.qml
msgid "e.g. fr_BE, en_GB, nl_BE"
msgstr "ex. fr_BE, en_GB, nl_BE"

#: contents/ui/configAppearance.qml
msgid "Locale used for weekday and month names. Leave empty to use the system locale."
msgstr "Paramètres régionaux utilisés pour les noms des jours et des mois. Laisser vide pour utiliser les paramètres régionaux du système."

#: contents/ui/configAppearance.qml
msgid "Day"
msgstr "Jour"

#: contents/ui/configAppearance.qml
msgid "Show day"
msgstr "Afficher le jour"

#: contents/ui/configAppearance.qml
msgid "Font size:"
msgstr "Taille de la police :"

#: contents/ui/configAppearance.qml
msgid "Letter spacing:"
msgstr "Espacement des lettres :"

#: contents/ui/configAppearance.qml
msgid "Day format:"
msgstr "Format du jour :"

#: contents/ui/configAppearance.qml
msgid "Use Qt date formats. For example: dddd = full weekday name, ddd = short weekday name."
msgstr "Utilisez les formats de date Qt. Par exemple : dddd = nom complet du jour de la semaine, ddd = nom court du jour de la semaine."

#: contents/ui/configAppearance.qml
msgid "Uppercase"
msgstr "Majuscules"

#: contents/ui/configAppearance.qml
msgid "Bold"
msgstr "Gras"

#: contents/ui/configAppearance.qml
msgid "Font color:"
msgstr "Couleur de la police :"

#: contents/ui/configAppearance.qml
msgid "Date"
msgstr "Date"

#: contents/ui/configAppearance.qml
msgid "Show date"
msgstr "Afficher la date"

#: contents/ui/configAppearance.qml
msgid "Date format:"
msgstr "Format de la date :"

#: contents/ui/configAppearance.qml
msgid "Use Qt date formats like dd MMM yyyy, MM/dd/yyyy, or dddd d MMMM yyyy."
msgstr "Utilisez les formats de date Qt comme dd MMM yyyy, MM/dd/yyyy ou dddd d MMMM yyyy."

#: contents/ui/configAppearance.qml
msgid "Time"
msgstr "Heure"

#: contents/ui/configAppearance.qml
msgid "Show time"
msgstr "Afficher l'heure"

#: contents/ui/configAppearance.qml
msgid "Use 24-hour format"
msgstr "Utiliser le format 24 heures"

#: contents/ui/configAppearance.qml
msgid "Time format:"
msgstr "Format de l'heure :"

#: contents/ui/configAppearance.qml
msgid "Use Qt time formats like hh:mm, hh:mm:ss, or hh:mm AP. Leave empty to use the 12/24-hour setting."
msgstr "Utilisez les formats d'heure Qt comme hh:mm, hh:mm:ss ou hh:mm AP. Laisser vide pour utiliser le paramètre 12/24 heures."

#: contents/ui/configAppearance.qml
msgid "Decoration character:"
msgstr "Caractère de décoration :"

#: contents/ui/configAppearance.qml
msgid "A character displayed on both sides of the time. Leave empty to show no decoration."
msgstr "Un caractère affiché de chaque côté de l'heure. Laisser vide pour ne pas afficher de décoration."

#: contents/ui/configAppearance.qml
msgid "Auto-scale (fitting widget size)"
msgstr "Mise à l'échelle automatique (ajustement à la taille du widget)"

#: contents/ui/configAppearance.qml
msgid "Element Order"
msgstr "Ordre des éléments"

#: contents/ui/configAppearance.qml
msgid "Use the arrows to reorder elements from top to bottom."
msgstr "Utilisez les flèches pour réorganiser les éléments de haut en bas."

#: contents/ui/configAppearance.qml
msgid "Reset Global Settings"
msgstr "Réinitialiser les paramètres globaux"

#: contents/ui/configAppearance.qml
msgid "Restore global settings to defaults"
msgstr "Restaurer les paramètres globaux par défaut"

#: contents/ui/configAppearance.qml
msgid "Reset Day Settings"
msgstr "Réinitialiser les paramètres du jour"

#: contents/ui/configAppearance.qml
msgid "Restore day settings to defaults"
msgstr "Restaurer les paramètres du jour par défaut"

#: contents/ui/configAppearance.qml
msgid "Reset Date Settings"
msgstr "Réinitialiser les paramètres de la date"

#: contents/ui/configAppearance.qml
msgid "Restore date settings to defaults"
msgstr "Restaurer les paramètres de la date par défaut"

#: contents/ui/configAppearance.qml
msgid "Reset Time Settings"
msgstr "Réinitialiser les paramètres de l'heure"

#: contents/ui/configAppearance.qml
msgid "Restore time settings to defaults"
msgstr "Restaurer les paramètres de l'heure par défaut"

#: contents/ui/configAppearance.qml
msgid "Adapt colors to system theme"
msgstr "Adapter les couleurs au thème du système"

#: contents/ui/configAppearance.qml
msgid "Override element colors with the system theme text color for better contrast"
msgstr "Remplacer les couleurs des éléments par la couleur du texte du thème système pour un meilleur contraste"

#: contents/ui/configAppearance.qml
msgid "Custom Text"
msgstr "Texte personnalisé"

#: contents/ui/configAppearance.qml
msgid "Show custom text"
msgstr "Afficher le texte personnalisé"

#: contents/ui/configAppearance.qml
msgid "Text:"
msgstr "Texte :"

#: contents/ui/configAppearance.qml
msgid "e.g. Good Morning, or HH:mm for live time"
msgstr "ex. Bonjour, ou HH:mm pour l'heure en direct"

#: contents/ui/configAppearance.qml
msgid "Static text, or a Qt date/time format (e.g. dddd, HH:mm, yyyy-MM-dd)"
msgstr "Texte statique, ou un format date/heure Qt (ex. dddd, HH:mm, yyyy-MM-dd)"

#: contents/ui/configAppearance.qml
msgid "Interpret as date/time format"
msgstr "Interpréter comme format date/heure"

#: contents/ui/configAppearance.qml
msgid "When enabled, Qt format tokens like dddd or HH:mm are replaced with the current date/time"
msgstr "Lorsque activé, les jetons de format Qt comme dddd ou HH:mm sont remplacés par la date/heure actuelle"

#: contents/ui/configAppearance.qml
msgid "Reset Custom Text Settings"
msgstr "Réinitialiser les paramètres du texte personnalisé"

#: contents/ui/configAppearance.qml
msgid "Restore custom text settings to defaults"
msgstr "Restaurer les paramètres du texte personnalisé par défaut"

#: contents/ui/configAppearance.qml
msgid "Secondary Timezone"
msgstr "Fuseau horaire secondaire"

#: contents/ui/configAppearance.qml
msgid "Show secondary timezone"
msgstr "Afficher le fuseau horaire secondaire"

#: contents/ui/configAppearance.qml
msgid "Timezone ID:"
msgstr "ID du fuseau horaire :"

#: contents/ui/configAppearance.qml
msgid "e.g. America/New_York, Europe/Tokyo"
msgstr "ex. America/New_York, Europe/Tokyo"

#: contents/ui/configAppearance.qml
msgid "IANA timezone identifier. Find yours at timezonedb.com"
msgstr "Identifiant de fuseau horaire IANA. Trouvez le vôtre sur timezonedb.com"

#: contents/ui/configAppearance.qml
msgid "Label:"
msgstr "Étiquette :"

#: contents/ui/configAppearance.qml
msgid "e.g. NYC, Tokyo"
msgstr "ex. NYC, Tokyo"

#: contents/ui/configAppearance.qml
msgid "Short label displayed before the timezone time. Leave empty for no label."
msgstr "Étiquette courte affichée avant l'heure du fuseau. Laisser vide pour aucune étiquette."

#: contents/ui/configAppearance.qml
msgid "Format:"
msgstr "Format :"

#: contents/ui/configAppearance.qml
msgid "Time format using HH (24h), H, mm, m tokens"
msgstr "Format d'heure utilisant les jetons HH (24h), H, mm, m"

#: contents/ui/configAppearance.qml
msgid "Reset Timezone Settings"
msgstr "Réinitialiser les paramètres du fuseau horaire"

#: contents/ui/configAppearance.qml
msgid "Restore timezone settings to defaults"
msgstr "Restaurer les paramètres du fuseau horaire par défaut"

#: contents/ui/configAppearance.qml
msgid "Themes"
msgstr "Thèmes"

#: contents/ui/configAppearance.qml
msgid "Save Current Theme"
msgstr "Enregistrer le thème actuel"

#: contents/ui/configAppearance.qml
msgid "No saved themes yet."
msgstr "Aucun thème enregistré pour le moment."

#: contents/ui/configAppearance.qml
msgid "Import Theme"
msgstr "Importer un thème"

#: contents/ui/configAppearance.qml
msgid "Advanced: Raw JSON"
msgstr "Avancé : JSON brut"

#: contents/ui/configAppearance.qml
msgid "Save Theme"
msgstr "Enregistrer le thème"

#: contents/ui/configAppearance.qml
msgid "Export Theme"
msgstr "Exporter le thème"

#: contents/ui/configAppearance.qml
msgid "Copy this JSON to share or back up your theme."
msgstr "Copiez ce JSON pour partager ou sauvegarder votre thème."

#: contents/ui/configAppearance.qml
msgid "Paste a theme JSON below. It will be added to your saved themes."
msgstr "Collez un JSON de thème ci-dessous. Il sera ajouté à vos thèmes enregistrés."

#: contents/ui/configAppearance.qml
msgid "Paste theme JSON here..."
msgstr "Collez le JSON du thème ici..."

#: contents/ui/configAppearance.qml
msgid "Invalid JSON: %1"
msgstr "JSON invalide : %1"

#: contents/ui/configAppearance.qml
msgid "Widget Configuration (Raw JSON)"
msgstr "Configuration du widget (JSON brut)"

#: contents/ui/configAppearance.qml
msgid "Copy this JSON to save your full config, or paste a previously saved JSON to restore it."
msgstr "Copiez ce JSON pour sauvegarder votre configuration complète, ou collez un JSON précédemment enregistré pour la restaurer."

#: contents/ui/configAppearance.qml
msgid "Apply Pasted Config"
msgstr "Appliquer la configuration collée"

#: contents/ui/configAppearance.qml
msgid "Reset to current"
msgstr "Réinitialiser à l'actuel"

#: contents/ui/configAppearance.qml
msgid "Load this theme"
msgstr "Charger ce thème"

#: contents/ui/configAppearance.qml
msgid "Export this theme"
msgstr "Exporter ce thème"

#: contents/ui/configAppearance.qml
msgid "Delete this theme"
msgstr "Supprimer ce thème"

