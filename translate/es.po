#: contents/ui/configAppearance.qml contents/ui/OrderSection.qml
msgid "Custom"
msgstr ""

#: contents/ui/configAppearance.qml
msgid "Custom Locale:"
msgstr ""

#: contents/ui/configAppearance.qml
msgid "e.g. fr_BE, en_GB, nl_BE"
msgstr "ej. es_ES, en_US, fr_FR"

#: contents/ui/configAppearance.qml
msgid "Locale used for weekday and month names. Leave empty to use the system locale."
msgstr "Configuración regional para los nombres de días y meses. Dejar vacío para usar la del sistema."

#: contents/ui/configAppearance.qml
msgid "Reset Global Settings"
msgstr "Restablecer ajustes globales"

#: contents/ui/configAppearance.qml
msgid "Restore global settings to defaults"
msgstr "Restaurar los ajustes globales a los valores predeterminados"

#: contents/ui/configAppearance.qml
msgid "Element Order"
msgstr "Orden de elementos"

#: contents/ui/configAppearance.qml
msgid "Use the arrows to reorder elements from top to bottom."
msgstr "Usa las flechas para reordenar los elementos de arriba a abajo."

#: contents/ui/configAppearance.qml contents/ui/OrderSection.qml
msgid "Day"
msgstr "Día"

#: contents/ui/configAppearance.qml
msgid "Show day"
msgstr "Mostrar día"

#: contents/ui/configAppearance.qml
msgid "Font:"
msgstr ""

#: contents/ui/configAppearance.qml
msgid "Font size:"
msgstr "Tamaño de fuente:"

#: contents/ui/configAppearance.qml
msgid "Letter spacing:"
msgstr "Espaciado entre letras:"

#: contents/ui/configAppearance.qml
msgid "Format:"
msgstr "Formato:"

#: contents/ui/configAppearance.qml
msgid "Use Qt date formats. For example: dddd = full weekday name, ddd = short weekday name."
msgstr "Usa formatos de fecha de Qt. Por ejemplo: dddd = nombre completo del día, ddd = nombre abreviado del día."

#: contents/ui/configAppearance.qml
msgid "Uppercase"
msgstr "Mayúsculas"

#: contents/ui/configAppearance.qml
msgid "Bold"
msgstr "Negrita"

#: contents/ui/configAppearance.qml
msgid "Font color:"
msgstr "Color de fuente:"

#: contents/ui/configAppearance.qml
msgid "Reset Day Settings"
msgstr "Restablecer ajustes del día"

#: contents/ui/configAppearance.qml
msgid "Restore day settings to defaults"
msgstr "Restaurar los ajustes del día a los valores predeterminados"

#: contents/ui/configAppearance.qml contents/ui/OrderSection.qml
msgid "Date"
msgstr "Fecha"

#: contents/ui/configAppearance.qml
msgid "Show date"
msgstr "Mostrar fecha"

#: contents/ui/configAppearance.qml
msgid "Use Qt date formats like dd MMM yyyy, MM/dd/yyyy, or dddd d MMMM yyyy."
msgstr "Usa formatos de fecha de Qt como dd MMM yyyy, MM/dd/yyyy o dddd d MMMM yyyy."

#: contents/ui/configAppearance.qml
msgid "Reset Date Settings"
msgstr "Restablecer ajustes de fecha"

#: contents/ui/configAppearance.qml
msgid "Restore date settings to defaults"
msgstr "Restaurar los ajustes de fecha a los valores predeterminados"

#: contents/ui/configAppearance.qml contents/ui/OrderSection.qml
msgid "Time"
msgstr "Hora"

#: contents/ui/configAppearance.qml
msgid "Show time"
msgstr "Mostrar hora"

#: contents/ui/configAppearance.qml
msgid "hh:mm"
msgstr ""

#: contents/ui/configAppearance.qml
msgid "Use Qt time formats like hh:mm, hh:mm:ss, or hh:mm AP. Leave empty to use the 12/24-hour setting."
msgstr "Usa formatos de hora de Qt como hh:mm, hh:mm:ss o hh:mm AP. Dejar vacío para usar la configuración de 12/24 horas."

#: contents/ui/configAppearance.qml
msgid "Use 24-hour format"
msgstr "Usar formato de 24 horas"

#: contents/ui/configAppearance.qml
msgid "Decoration character:"
msgstr "Carácter de decoración:"

#: contents/ui/configAppearance.qml
msgid "A character displayed on both sides of the time. Leave empty to show no decoration."
msgstr "Un carácter que se muestra a ambos lados de la hora. Dejar vacío para no mostrar decoración."

#: contents/ui/configAppearance.qml
msgid "Reset Time Settings"
msgstr "Restablecer ajustes de hora"

#: contents/ui/configAppearance.qml
msgid "Restore time settings to defaults"
msgstr "Restaurar los ajustes de hora a los valores predeterminados"

#: contents/ui/configAppearance.qml
msgid "Custom Text"
msgstr "Texto personalizado"

#: contents/ui/configAppearance.qml
msgid "Show custom text"
msgstr "Mostrar texto personalizado"

#: contents/ui/configAppearance.qml
msgid "Text:"
msgstr "Texto:"

#: contents/ui/configAppearance.qml
msgid "e.g. Good Morning, or HH:mm for live time"
msgstr "ej. Buenos días, o HH:mm para la hora actual"

#: contents/ui/configAppearance.qml
msgid "Static text, or a Qt date/time format (e.g. dddd, HH:mm, yyyy-MM-dd)"
msgstr "Texto estático, o un formato de fecha/hora de Qt (ej. dddd, HH:mm, yyyy-MM-dd)"

#: contents/ui/configAppearance.qml
msgid "Interpret as date/time format"
msgstr "Interpretar como formato de fecha/hora"

#: contents/ui/configAppearance.qml
msgid "When enabled, Qt format tokens like dddd or HH:mm are replaced with the current date/time"
msgstr "Cuando está activado, los códigos de formato Qt como dddd o HH:mm se reemplazan por la fecha/hora actual"

#: contents/ui/configAppearance.qml
msgid "Reset Custom Text Settings"
msgstr "Restablecer ajustes de texto personalizado"

#: contents/ui/configAppearance.qml
msgid "Restore custom text settings to defaults"
msgstr "Restaurar los ajustes de texto personalizado a los valores predeterminados"

#: contents/ui/configAppearance.qml
msgid "Secondary Timezone"
msgstr "Zona horaria secundaria"

#: contents/ui/configAppearance.qml
msgid "Show secondary timezone"
msgstr "Mostrar zona horaria secundaria"

#: contents/ui/configAppearance.qml
msgid "Timezone:"
msgstr "Zona horaria:"

#: contents/ui/configAppearance.qml
msgid "Select a timezone or type a custom IANA ID"
msgstr "Selecciona una zona horaria o escribe un ID IANA personalizado"

#: contents/ui/configAppearance.qml
msgid "Label:"
msgstr "Etiqueta:"

#: contents/ui/configAppearance.qml
msgid "e.g. NYC, Tokyo"
msgstr "ej. NYC, Tokio"

#: contents/ui/configAppearance.qml
msgid "Short label displayed before the timezone time. Leave empty for no label."
msgstr "Etiqueta corta que se muestra antes de la hora de la zona horaria. Dejar vacío para no mostrar etiqueta."

#: contents/ui/configAppearance.qml
msgid "Reset Timezone Settings"
msgstr "Restablecer ajustes de zona horaria"

#: contents/ui/configAppearance.qml
msgid "Restore timezone settings to defaults"
msgstr "Restaurar los ajustes de zona horaria a los valores predeterminados"

#: contents/ui/configAppearance.qml
msgid "Themes"
msgstr "Temas"

#: contents/ui/configAppearance.qml
msgid "Save Current Theme"
msgstr "Guardar tema actual"

#: contents/ui/configAppearance.qml
msgid "Untitled"
msgstr "Sin título"

#: contents/ui/configAppearance.qml
msgid "Load this theme"
msgstr "Cargar este tema"

#: contents/ui/configAppearance.qml
msgid "Export this theme"
msgstr "Exportar este tema"

#: contents/ui/configAppearance.qml
msgid "Delete this theme"
msgstr "Eliminar este tema"

#: contents/ui/configAppearance.qml
msgid "No saved themes yet."
msgstr "No hay temas guardados aún."

#: contents/ui/configAppearance.qml contents/ui/ThemeSheets.qml
msgid "Import Theme"
msgstr "Importar tema"

#: contents/ui/configAppearance.qml
msgid "Advanced: Raw JSON"
msgstr "Avanzado: JSON sin procesar"

#: contents/ui/OrderSection.qml
msgid "Timezone"
msgstr ""

#: contents/ui/OrderSection.qml
msgid "Move up"
msgstr ""

#: contents/ui/OrderSection.qml
msgid "Move down"
msgstr ""

#: contents/ui/ThemeSheets.qml
msgid "Save Theme"
msgstr "Guardar tema"

#: contents/ui/ThemeSheets.qml
msgid "Name:"
msgstr "Nombre:"

#: contents/ui/ThemeSheets.qml
msgid "My Theme"
msgstr "Mi tema"

#: contents/ui/ThemeSheets.qml
msgid "Description:"
msgstr "Descripción:"

#: contents/ui/ThemeSheets.qml
msgid "Optional description"
msgstr "Descripción opcional"

#: contents/ui/ThemeSheets.qml
msgid "Save"
msgstr ""

#: contents/ui/ThemeSheets.qml
msgid "Cancel"
msgstr ""

#: contents/ui/ThemeSheets.qml
msgid "Export Theme"
msgstr "Exportar tema"

#: contents/ui/ThemeSheets.qml
msgid "Copy this JSON to share or back up your theme."
msgstr "Copia este JSON para compartir o respaldar tu tema."

#: contents/ui/ThemeSheets.qml
msgid "Close"
msgstr ""

#: contents/ui/ThemeSheets.qml
msgid "Paste a theme JSON below. It will be added to your saved themes."
msgstr "Pega un JSON de tema a continuación. Se añadirá a tus temas guardados."

#: contents/ui/ThemeSheets.qml
msgid "Paste theme JSON here..."
msgstr "Pega el JSON del tema aquí..."

#: contents/ui/ThemeSheets.qml
msgid "Import"
msgstr ""

#: contents/ui/ThemeSheets.qml
msgid "Invalid JSON: %1"
msgstr "JSON no válido: %1"

#: contents/ui/ThemeSheets.qml
msgid "Widget Configuration (Raw JSON)"
msgstr "Configuración del widget (JSON sin procesar)"

#: contents/ui/ThemeSheets.qml
msgid "Copy this JSON to save your full config, or paste a previously saved JSON to restore it."
msgstr "Copia este JSON para guardar tu configuración completa, o pega un JSON guardado previamente para restaurarlo."

#: contents/ui/ThemeSheets.qml
msgid "Apply Pasted Config"
msgstr "Aplicar configuración pegada"

#: contents/ui/ThemeSheets.qml
msgid "Reset to current"
msgstr "Restablecer al actual"

