<?xml version="1.0" encoding="UTF-8"?>

<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0 http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
    <kcfgfile name="" />
    <group name="Appearance">
        <entry name="day_font_size" type="Int">
            <default>72</default>
        </entry>
        <entry name="day_letter_spacing" type="Int">
            <default>17</default>
        </entry>
        <entry name="show_day" type="Bool">
            <default>true</default>
        </entry>
        <entry name="date_font_size" type="Int">
            <default>19</default>
        </entry>
        <entry name="date_letter_spacing" type="Int">
            <default>3</default>
        </entry>
        <entry name="locale" type="String">
            <default></default>
        </entry>
        <entry name="date_format" type="String">
            <default>dd MMM yyyy</default>
        </entry>
        <entry name="show_date" type="Bool">
            <default>true</default>
        </entry>
        <entry name="time_font_size" type="Int">
            <default>19</default>
        </entry>
        <entry name="time_letter_spacing" type="Int">
            <default>3</default>
        </entry>
        <entry name="time_format" type="String">
            <default></default>
        </entry>
        <entry name="time_font_color" type="Color">
            <default>#FFFFFF</default>
        </entry>
        <entry name="show_time" type="Bool">
            <default>true</default>
        </entry>
        <entry name="date_font_color" type="Color">
            <default>#FFFFFF</default>
        </entry>
        <entry name="day_font_color" type="Color">
            <default>#FFFFFF</default>
        </entry>
        <entry name="use_24_hour_format" type="Bool">
            <default>false</default>
        </entry>
        <entry name="time_character" type="String">
            <default>-</default>
        </entry>
        <entry name="widget_spacing" type="Int">
            <default>5</default>
        </entry>
        <entry name="day_format" type="String">
            <default>dddd</default>
        </entry>
        <entry name="uppercase_day" type="Bool">
            <default>true</default>
        </entry>
        <entry name="uppercase_date" type="Bool">
            <default>true</default>
        </entry>
        <entry name="day_font_bold" type="Bool">
            <default>false</default>
        </entry>
        <entry name="date_font_bold" type="Bool">
            <default>false</default>
        </entry>
        <entry name="time_font_bold" type="Bool">
            <default>false</default>
        </entry>
        <entry name="auto_scale" type="Bool">
            <default>false</default>
        </entry>
        <entry name="fontFamilyDay" type="String">
            <label>Font family for day name. e.g "Arial", "Anurati"</label>
            <default>Anurati</default>
        </entry>
        <entry name="fontFamilyDate" type="String">
            <label>Font family for date. e.g "Arial", "Poppins"</label>
            <default>Poppins</default>
        </entry>
        <entry name="fontFamilyTime" type="String">
            <label>Font family for time. e.g "Arial", "Poppins"</label>
            <default>Poppins</default>
        </entry>
        <entry name="element_order" type="String">
            <label>Order of elements from top to bottom. Comma-separated list of: day, date, time, custom, timezone</label>
            <default>day,date,time,custom,timezone</default>
        </entry>
        <entry name="saved_themes" type="String">
            <label>Saved themes as a JSON array</label>
            <default></default>
        </entry>

        <!-- Custom text element -->
        <entry name="show_custom" type="Bool">
            <default>false</default>
        </entry>
        <entry name="custom_text" type="String">
            <default></default>
        </entry>
        <entry name="custom_format" type="Bool">
            <label>Interpret custom text as Qt date/time format</label>
            <default>false</default>
        </entry>
        <entry name="fontFamilyCustom" type="String">
            <default>Poppins</default>
        </entry>
        <entry name="custom_font_size" type="Int">
            <default>19</default>
        </entry>
        <entry name="custom_letter_spacing" type="Int">
            <default>3</default>
        </entry>
        <entry name="custom_font_bold" type="Bool">
            <default>false</default>
        </entry>
        <entry name="custom_font_color" type="Color">
            <default>#FFFFFF</default>
        </entry>

        <!-- Secondary timezone element -->
        <entry name="show_timezone" type="Bool">
            <default>false</default>
        </entry>
        <entry name="timezone_id" type="String">
            <label>IANA timezone ID, e.g. America/New_York</label>
            <default></default>
        </entry>
        <entry name="timezone_label" type="String">
            <label>Short label displayed before the timezone time</label>
            <default></default>
        </entry>
        <entry name="timezone_display_text" type="String">
            <label>Display text shown in the timezone ComboBox (e.g. UTC+1:00 — Paris)</label>
            <default></default>
        </entry>
        <entry name="timezone_format" type="String">
            <label>Time format for the timezone display</label>
            <default>HH:mm</default>
        </entry>
        <entry name="fontFamilyTimezone" type="String">
            <default>Poppins</default>
        </entry>
        <entry name="timezone_font_size" type="Int">
            <default>19</default>
        </entry>
        <entry name="timezone_letter_spacing" type="Int">
            <default>3</default>
        </entry>
        <entry name="timezone_font_bold" type="Bool">
            <default>false</default>
        </entry>
        <entry name="timezone_font_color" type="Color">
            <default>#FFFFFF</default>
        </entry>

        <!-- Color mode: custom, theme, theme_inverse, wallpaper -->
        <entry name="color_mode" type="String">
            <label>Color mode for elements. custom = per-element colors, theme = follow system text color, theme_inverse = inverse of system text color, wallpaper = derived from wallpaper brightness</label>
            <default>custom</default>
        </entry>

        <!-- Deprecated: kept for migration from older configs -->
        <entry name="adapt_to_theme" type="Bool">
            <default>false</default>
        </entry>
    </group>
</kcfg>